{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {},
    "paceWorkout": {
      "extends": "sqliteTest",
      "env": { "RUNJOURNEY_PACE_ISOLATED": "1" },
      "android": {
        "withoutCredentials": true,
        "gradleCommand": ":app:assemblePaceWorkout",
        "applicationArchivePath": "android/app/build/outputs/apk/paceWorkout/*.apk"
      }
    },
    "cloudSyncTest": {
      "extends": "sqliteTest",
      "env": { "RUNJOURNEY_REQUIRE_CLOUD": "1" }
    },
    "sqliteTest": {
      "distribution": "internal",
      "environment": "preview",
      "node": "22.13.1",
      "android": {
        "withoutCredentials": true,
        "gradleCommand": ":app:assembleStandaloneTest",
        "applicationArchivePath": "android/app/build/outputs/apk/standaloneTest/*.apk"
      }
    }
  }
}
